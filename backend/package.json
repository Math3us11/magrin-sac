{
  "name": "backend",
  "version": "0.1.0",
  "description": "API do Sistema de Agendamento da Coordenação",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"*.md\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"*.md\"",
    "lint": "eslint \"src/**/*.ts\" && prettier --check \"src/**/*.ts\" \"*.md\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix && prettier --write \"src/**/*.ts\" \"*.md\"",
    "check": "pnpm lint && pnpm test && pnpm build",
    "db:create": "pnpm build && node --env-file-if-exists=.env dist/database/database-cli.js create",
    "db:check": "pnpm build && node --env-file-if-exists=.env dist/database/database-cli.js check",
    "db:bootstrap:admin": "pnpm build && node --env-file-if-exists=.env dist/database/database-cli.js bootstrap:admin",
    "db:migrate": "pnpm build && node --env-file-if-exists=.env dist/database/database-cli.js migrate",
    "db:migrate:undo": "pnpm build && node --env-file-if-exists=.env dist/database/database-cli.js migrate:undo",
    "db:migrate:status": "pnpm build && node --env-file-if-exists=.env dist/database/database-cli.js migrate:status",
    "db:setup": "pnpm build && node --env-file-if-exists=.env dist/database/database-cli.js setup",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "test": "pnpm build && node --test test/*.test.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.1",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/sequelize": "^12.0.0",
    "argon2": "^0.45.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.3.0",
    "joi": "^18.2.9",
    "mariadb": "^3.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sequelize": "^6.37.8",
    "sequelize-typescript": "^2.1.6",
    "umzug": "^3.8.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "prettier": "^3.6.2",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.70.0"
  },
  "engines": {
    "node": ">=24.12.0 <25",
    "pnpm": "11.18.0"
  }
}
