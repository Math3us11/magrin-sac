# Ambiente compartilhado pelo frontend e backend
APP_ENV=development
APP_TIMEZONE=America/Porto_Velho

# Frontend: toda variável VITE_* é pública e incluída no bundle
VITE_API_BASE_URL=/api

# API
APP_HOST=127.0.0.1
APP_SERVE_FRONTEND=false
PORT=3000
CORS_ORIGIN=http://localhost:5173

# Demonstração remota via Cloudflare Tunnel (não altera APP_ENV)
CLOUDFLARE_TUNNEL_ID=
CLOUDFLARE_PUBLIC_HOSTNAME=agenda.magrinapp.com
CLOUDFLARE_TUNNEL_ORIGIN=http://127.0.0.1:3100
# Opcional: por padrão usa %USERPROFILE%/.cloudflared/<UUID>.json
CLOUDFLARE_TUNNEL_CREDENTIALS_FILE=

# Sessão e autenticação
AUTH_SESSION_COOKIE_NAME=magrin_sac_session
AUTH_SESSION_COOKIE_SECURE=false
AUTH_SESSION_JWT_AUDIENCE=magrin-sac-frontend
AUTH_SESSION_JWT_ISSUER=magrin-sac-api
AUTH_SESSION_JWT_SECRET=
AUTH_SESSION_JWT_TTL_SECONDS=
# Bloqueia temporariamente a combinação e-mail + IP após falhas consecutivas no login,
# sem travar a mesma conta acessada de outro IP.
AUTH_LOGIN_MAX_FAILURES=5
AUTH_LOGIN_WINDOW_SECONDS=300
# Limite de falhas por IP na mesma janela, contra tentativas em várias contas.
AUTH_LOGIN_MAX_FAILURES_PER_CLIENT=20
# Cabeçalho com o IP real do cliente. Use somente quando o backend escuta em loopback atrás
# de um proxy confiável; o ambiente remoto define cf-connecting-ip para o Cloudflare Tunnel.
AUTH_LOGIN_CLIENT_IP_HEADER=

# Chave privada RSA PKCS#8 em PEM codificada em Base64. Obrigatória em produção.
PASSWORD_ENCRYPTION_PRIVATE_KEY_BASE64=

# MariaDB
DB_DIALECT=mariadb
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=magrin_sac
# Banco usado exclusivamente pela versão estável publicada no túnel
STABLE_DB_DATABASE=magrin_sac_stable
DB_USERNAME=root
DB_PASSWORD=replace-with-local-password

# Bootstrap administrativo local opcional. Nunca versione credenciais reais.
BOOTSTRAP_ADMIN_NAME=Administrador
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_CPF=
BOOTSTRAP_ADMIN_BIRTH_DATE=

# Dados de demonstração (pnpm --filter backend db:seed:demo). O comando recria somente
# os registros das contas fictícias @demo.test e exige a confirmação explícita abaixo.
DEMO_SEED_ENABLED=false
DEMO_SEED_PASSWORD=
